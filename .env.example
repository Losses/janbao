# Site
PUBLIC_SITE_NAME="Janbao"
PUBLIC_SITE_SHORT_NAME="Janbao"
PUBLIC_SITE_DESCRIPTION="Janbao Forum"
# Brand the mobile first tab (Discussions): show the brand mark + wordmark
# (LogoGeometry + LogoText) instead of the forum icon / "Discussions" label
# ("true"/"1"/"yes" to enable)
PUBLIC_BRANDED_FIRST_TAB=""
# Whether users/admins are allowed to change their profile URL slug / username ("true" or "false")
ALLOW_SLUG_CHANGE="false"
# Whether the Activity page/tab is open to guest/unauthenticated users ("true" or "false", default is "false")
ALLOW_GUEST_ACTIVITY="false"
# Whether logged-out visitors may use the "Users" search scope ("true" or "false", default is "false")
ALLOW_GUEST_USER_SEARCH="false"
# Whether logged-out visitors may view profile pages ("true" or "false", default is "false")
ALLOW_GUEST_PROFILE_VIEW="false"

# Admin Bootstrap
# These are used to create the initial admin user on first run.
# Only takes effect when the database has no regular users yet.
# If skipped, there is no built-in way to create an admin later.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Cloudflare D1
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# Media storage: pcloud (default) or s3
MEDIA_STORAGE_PROVIDER="pcloud"

# pCloud media storage (WebDAV)
# Verify credentials and create the /avatars + /attachments folders by running:
#   bun scripts/setup-pcloud.ts   (it fills these in for you)
# For production, set the same via wrangler secret put.
# WebDAV uses email + password (Basic auth) on every request  - the account must
# NOT have 2FA enabled. EU: ewebdav.pcloud.com, US: webdav.pcloud.com.
PCLOUD_USERNAME=""
PCLOUD_PASSWORD=""
PCLOUD_WEBDAV_HOST="ewebdav.pcloud.com"
PCLOUD_BASE_PATH="/Janbao"

# Standard S3-compatible media storage
# S3_SESSION_TOKEN is only needed for temporary credentials.
# S3_FORCE_PATH_STYLE defaults to true; set false for virtual-hosted-style URLs.
# S3_ENDPOINT must be the service endpoint, without the bucket name.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""
S3_SESSION_TOKEN=""
S3_FORCE_PATH_STYLE="true"
S3_PREFIX="Janbao"
S3_CDN_BASE_URL=""

# SMTP Mailer Settings
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_AUTH_TYPE="plain"
SMTP_FROM_NAME="Janbao"
SMTP_FROM_EMAIL=""

# Post rate limiting (anti-duplicate-submit, per user per write surface).
# Defaults below apply when unset. Raise POST_THROTTLE_LIMIT (e.g. 3) to allow
# quick successive replies/messages; keep 1 to block all sub-window repeats.
POST_THROTTLE_WINDOW_SEC="10"
POST_THROTTLE_LIMIT="1"

# Web Push (VAPID) keypair - identifies this server to push services.
# Generate once with `bun scripts/generate-vapid-keys.ts` and keep stable:
# rotating the keypair invalidates every existing subscription.
#  - VAPID_PUBLIC_KEY:  base64url of the 65-byte uncompressed P-256 public key
#  - VAPID_PRIVATE_KEY: base64url of the 32-byte raw private scalar d
#  - VAPID_SUBJECT:     mailto: or https: URL identifying the sender
# When unset in a production build, push is disabled (the UI hides the push
# section). Local dev falls back to an ephemeral in-memory keypair.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
