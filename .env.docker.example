# Copy this file to .env.docker before running docker compose.
# Generate a production value with: openssl rand -hex 32
JWT_SECRET=""

# SvelteKit adapter-node runtime
NODE_ENV="production"
HOST="0.0.0.0"
PORT="3000"
# Set to your public origin when serving behind a reverse proxy, e.g. https://forum.example.com
ORIGIN=""
BODY_SIZE_LIMIT="50000000"
LOCAL_DB_PATH="/data/janbao.db"

# Site
PUBLIC_SITE_NAME="Janbao"
PUBLIC_SITE_SHORT_NAME="Janbao"
PUBLIC_SITE_DESCRIPTION="Janbao Forum"
ALLOW_SLUG_CHANGE="false"
# Guest access controls (default "false" = denied)
ALLOW_GUEST_ACTIVITY="false"
ALLOW_GUEST_USER_SEARCH="false"
ALLOW_GUEST_PROFILE_VIEW="false"
FORUM_TIMEZONE="UTC"
DISCUSSIONS_LIMIT="20"
PAGINATION_LIMIT="50"
ACTIVITIES_LIMIT="15"
MONTHLY_INVITATION_LIMIT="5"

# Admin bootstrap
# These only take effect when no admin user exists.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Media storage: pcloud (default) or s3
MEDIA_STORAGE_PROVIDER="pcloud"

# pCloud media storage (WebDAV)
PCLOUD_USERNAME=""
PCLOUD_PASSWORD=""
PCLOUD_WEBDAV_HOST="ewebdav.pcloud.com"
PCLOUD_BASE_PATH="/Janbao"

# Standard S3-compatible media storage
# S3_ENDPOINT must be the service endpoint, without the bucket name.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""
S3_SESSION_TOKEN=""
S3_FORCE_PATH_STYLE="true"
S3_PREFIX="Janbao"
S3_CDN_BASE_URL=""

# SMTP Mailer Settings
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_AUTH_TYPE="plain"
SMTP_FROM_NAME="Janbao"
SMTP_FROM_EMAIL=""

# Web Push (VAPID) - generate with `bun scripts/generate-vapid-keys.ts`.
# Empty disables push in production (local dev uses an ephemeral keypair).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
